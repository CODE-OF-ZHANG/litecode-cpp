# =============================================================
# LiteCode-CPP — .dockerignore
# =============================================================
# 避免把不必要的文件（构建产物、依赖、日志、IDE 配置、git 历史）
# 拷进 Docker 构建上下文，加快构建、缩小镜像。
# =============================================================

# ─── 构建产物 ──────────────────────────────────────────
build/
bin/
*.exe
*.o
*.obj
*.a
*.lib
*.dll
*.pdb
*.ilk
*.d

# ─── CMake 生成 ─────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CMakeSettings.json
_deps/
*.cmake

# ─── Git / IDE / OS ──────────────────────────────────
.git/
.gitignore
.gitattributes
.github/
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── 项目本地配置 ──────────────────────────────────
.claude/
.superpowers/
.env                # 真实环境变量不进镜像（用 env_file 注入）
*.log
logs/

# ─── 文档（不进镜像）──────────────────────────────────
docs/
README.md
LICENSE
SPEC.md
dependence.md

# ─── 测试（不进 web 镜像）──────────────────────────
tests/

# ─── 备份文件 ─────────────────────────────────────────
*.bak
*.tmp
*.swp

# ─── 监控配置不进 web 构建上下文 ─────────────────
monitoring/

# ─── 反向代理配置不进 web 构建上下文 ────────────
Caddyfile