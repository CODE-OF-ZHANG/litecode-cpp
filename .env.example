# ─────────────────────────────────────────────────────────────────────────────
#  LiteCode-CPP environment template
#
#  Copy to `.env` and edit. The application reads this file via
#  `src/config.h::load_config()` at startup. Real env vars WIN over .env values
#  (12-factor convention), so docker-compose / k8s injected secrets take
#  precedence.
#
#  Only JWT_SECRET, DB_PASSWORD and ADMIN_PASSWORD must be set in production.
#  Everything else has a safe default in src/config.h.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_THREAD_POOL_SIZE=8

# ── Database (mysql-connector-c++ / X Protocol) ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=33060
DB_USER=litecode
DB_PASSWORD=changeme
DB_NAME=litecode
# DB_SOCKET=                             # optional: unix/named socket path
DB_POOL_MIN=4
DB_POOL_MAX=16
DB_CONN_TIMEOUT_SECONDS=10

# ── MySQL container root password (docker-compose mysql service) ────────────
# 仅 docker-compose mysql 容器内部使用；web 服务用上面 DB_PASSWORD 走业务库
MYSQL_ROOT_PASSWORD=changeme_root

# ── JWT (SPEC §5.1) ──────────────────────────────────────────────────────────
# REQUIRED in production. Generate with:  openssl rand -base64 48
# Must be at least 32 bytes. In dev, set LITECODE_ALLOW_INSECURE_DEFAULTS=1
# to fall back to an auto-generated placeholder (printed clearly in boot log).
JWT_SECRET=
JWT_ISSUER=litecode
JWT_ACCESS_TTL_SECONDS=7200            # 2h
JWT_REFRESH_TTL_SECONDS=604800         # 7d

# Allow ephemeral JWT secret in dev builds (refuses to start in production).
# LITECODE_ALLOW_INSECURE_DEFAULTS=0

# ── Judge (SPEC §7) ──────────────────────────────────────────────────────────
JUDGE_DEFAULT_TIME_LIMIT_MS=1000
JUDGE_DEFAULT_MEMORY_LIMIT_MB=256
JUDGE_COMPILE_TIMEOUT_SECONDS=10       # anti compile-bomb (SPEC §7.3)
JUDGE_RUN_TIMEOUT_SECONDS=30           # judge.sh hard timeout
JUDGE_HARD_TIMEOUT_SECONDS=30          # web-side outer timeout
JUDGE_MAX_CONCURRENT=4
JUDGE_WARM_POOL_SIZE=2
JUDGE_MAX_QUEUE_SIZE=50
JUDGE_OUTPUT_LIMIT_BYTES=16777216      # 16 MiB → OLE
JUDGE_CE_TRUNCATE_BYTES=4096
JUDGE_RE_TRUNCATE_BYTES=2048

# Docker (web → docker-socket-proxy on the proxy container)
DOCKER_SOCKET_URL=tcp://docker-proxy:2375
JUDGE_IMAGE=litecode-judge:latest
JUDGE_NETWORK_MODE=none
JUDGE_PIDS_LIMIT=50
JUDGE_CPP_COMPILE_FLAGS="-O2 -std=c++17 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2 -Wformat -Wformat-security -Wl,-z,now -Wl,-z,relro"

# ── Redis (optional; MVP uses in-memory) ─────────────────────────────────────
REDIS_ENABLED=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONN_TIMEOUT_SECONDS=5

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                          # TRACE/DEBUG/INFO/WARN/ERROR
LOG_FORMAT=json                         # json | text
LOG_FILE=                               # empty → stdout only
LOG_ROTATION_MAX_SIZE=10M
LOG_ROTATION_MAX_FILES=3
LOG_INCLUDE_REQUEST_ID=1

# ── CORS (SPEC §5.7) ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=1

# ── Rate limit (SPEC §5.1 / §15.2) ──────────────────────────────────────────
RATE_LIMIT_REGISTER_PER_MIN=5           # /api/v1/auth/register
RATE_LIMIT_LOGIN_PER_MIN=10             # /api/v1/auth/login
RATE_LIMIT_SUBMIT_PER_MIN=30            # /api/v1/submissions (per user)
RATE_LIMIT_ADMIN_WRITE_PER_MIN=30       # /api/v1/admin/* writes
RATE_LIMIT_BULK_IMPORT_PER_HOUR=5       # /api/v1/admin/problems/import

# ── Admin bootstrap (creates first admin if it doesn't exist) ───────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_change_me_now
ADMIN_EMAIL=admin@example.com

# ── Docker Compose（Phase 7）───────────────────────────────────────────────
# WEB_BIND  限制 web 端口绑定到的宿主机 IP；生产建议 127.0.0.1（Caddy 同机
#           反代），外网暴露走 80/443。
WEB_BIND=127.0.0.1

# Caddy 反向代理（profile=proxy；v1.2.76 双模式）
# CADDY_MODE=local（默认）：HTTP :80，挂 caddy/Caddyfile.local
# CADDY_MODE=prod：         HTTPS + on_demand TLS，挂 caddy/Caddyfile.prod
#                          必须同时设置 LITECODE_DOMAIN（公网可达域名）
CADDY_MODE=local
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# 生产 HTTPS 模式必填（Let's Encrypt 申请证书时验证域名所有权）
# LITECODE_DOMAIN=oj.example.com

# Prometheus / Grafana / Alertmanager / cAdvisor / node-exporter
# 都默认绑到 127.0.0.1（避免意外暴露到公网）。需要远程访问改成 0.0.0.0。
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_change_me_now
ALERTMANAGER_BIND=127.0.0.1
ALERTMANAGER_PORT=9093
CADVISOR_BIND=127.0.0.1
CADVISOR_PORT=8088
NODE_EXPORTER_BIND=127.0.0.1
NODE_EXPORTER_PORT=9100

# Loki / Promtail（profile=logging；Promtail 读取 Docker json-file 日志）
# Loki 默认只绑定本机，生产环境不要直接暴露到公网。
LOKI_BIND=127.0.0.1
LOKI_PORT=3100

# 数据库备份（profile=backup 启用；启动后每日 03:00 自动跑）
BACKUP_RETENTION_DAYS=14
BACKUP_COMPRESS=gzip                  # gzip | zstd | none
# RCLONE_REMOTE=rclone:bucket/litecode-backups   # 不设 = 不做异地
