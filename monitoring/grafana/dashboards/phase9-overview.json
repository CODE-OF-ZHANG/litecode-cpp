    {
      "id": 20,
      "type": "row",
      "title": "2. 判题 P50 / P95 / P99 延迟",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "判题延迟分位数（histogram_quantile over _bucket[5m]）",
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(litecode_judge_duration_seconds_bucket[5m])))",
