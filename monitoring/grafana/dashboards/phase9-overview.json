      "id": 52,
      "type": "timeseries",
      "title": "Web 容器内存使用",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 35},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{name=\"litecode-web\"}) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
