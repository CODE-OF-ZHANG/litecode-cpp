      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "red",   "value": 0.01}
          ]}
        }
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "提交终态分布（rate by status）",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (status) (rate(litecode_submissions_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
