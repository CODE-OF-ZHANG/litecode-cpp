  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1. 系统概览（v1.2.68 §16.4 live gauges）",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
