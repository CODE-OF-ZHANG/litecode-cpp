    },
    {
      "id": 31,
      "type": "stat",
      "title": "AC 占比 (5m)",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(litecode_submissions_total{status=\"ac\"}[5m])) / clamp_min(sum(rate(litecode_submissions_total[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red",   "value": null},
            {"color": "yellow", "value": 0.4},
            {"color": "green",  "value": 0.6}
          ]}
        }
      }
    },
    {
      "id": 32,
      "type": "stat",
      "title": "系统错误 (5m)",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(litecode_submissions_total{status=\"se\"}[5m]))",
          "refId": "A"
