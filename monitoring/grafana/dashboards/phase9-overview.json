    {
      "id": 30,
      "type": "row",
      "title": "3. 错误率（v1.2.68 暂未暴露 litecode_http_requests_total；以提交终态分布为代理）",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15},
