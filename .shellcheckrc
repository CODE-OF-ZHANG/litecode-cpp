# =============================================================
# LiteCode-CPP — ShellCheck 配置
# =============================================================
# SPEC §15.8 / Phase 8 CI/CD 流水线
# -------------------------------------------------------------
# shell-级别：bash（项目所有 .sh 默认解释器）
# 严重度门禁：warning（warning+ 触发 CI 失败；info/style 默认不 fail）
# 外部源 allowlist：判题脚本里的 docker / mysql / rclone / curl / nc
#                    / jq / mysqldump / git / sudo 等都是 CI 环境预装
# =============================================================

shell=bash

# ───── 严重度 ──────────────────────────────────────────────
severity=warning

# ───── 外部源 allowlist ──────────────────────────────────
# shellcheck 不识别这些为命令；项目里判题/备份/部署都用
external-sources=true
shellcheck-extra-images=alpine:3.20,ubuntu:22.04,ubuntu:24.04

# ───── 选项 ──────────────────────────────────────────────
# SC2086 关闭：双引号变量展开提醒；项目里有大量受控展开场景
# SC2155 关闭：声明+赋值分开提醒；项目惯用 `local x=$(cmd)`
disable=SC2086,SC2155

# ───── exclude 列表 ─────────────────────────────────────
# third_party/* 不扫（外部代码）
# build/ / bin/ 不扫（构建产物）
