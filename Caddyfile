# =============================================================
# LiteCode-CPP — Caddy 反向代理配置
# =============================================================
# SPEC §11 Phase 1 / Phase 7
# -------------------------------------------------------------
# 本地开发：HTTP only，监听 :80
# 生产环境：取消下方 "production" 段注释，填入域名，Caddy 自动申请证书
# =============================================================

# ───── 本地开发（默认） ──────────────────────────────────────
{
    # 全局选项
    admin off                       # 禁用 admin API（容器内无需）
    auto_https off                  # 本地不自动 HTTPS
    # log 格式：JSON，便于 Loki/ELK 聚合
    log default {
        format json
        level INFO
    }
}

# HTTP 入口，转发到 web 容器
:80 {
    # 把真实客户端 IP 透传给后端（X-Forwarded-For）
    reverse_proxy litecode-web:8080 {
        # 健康检查（被代理端）
        health_uri /api/v1/health
        health_interval 10s
        health_timeout 5s

        # 透明传输 Header
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # 响应头：CSP（与前端 meta CSP 配套，防御纵深）
        header_down Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"

        # 隐藏后端服务器信息
        header_down -Server
        header_down -X-Powered-By
    }

    # 安全响应头
    header {
        # 防 XSS / MIME sniffing / clickjacking
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # HSTS 仅在 HTTPS 启用（避免本地 HTTP 下浏览器拒绝）
        # Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # 移除泄露信息的头
        -Server
    }

    # 编码：交给 Caddy 自动 gzip
    encode gzip zstd
}

# ───── 生产示例（取消注释并填入域名） ──────────────────────
# 1. 在 Caddyfile 同目录放 Caddy 自动获取证书需要的 DNS API token 环境变量
# 2. Caddy 启动时会自动从 Let's Encrypt 申请证书
# 3. 若需 cloudflare / alidns 等 DNS-01 验证，参考：
#    https://github.com/caddy-dns/cloudflare
#    https://github.com/caddy-dns/alidns
#
