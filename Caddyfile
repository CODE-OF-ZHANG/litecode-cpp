# =============================================================
# LiteCode-CPP — Caddy 反向代理配置
# =============================================================
# SPEC §11 Phase 1 / Phase 7
# -------------------------------------------------------------
# 本地开发：HTTP only，监听 :80
# 生产环境：取消下方 "production" 段注释，填入域名，Caddy 自动申请证书
# -------------------------------------------------------------
# SRI (Subresource-Integrity) 说明
# -------------------------------------------------------------
# SRI 是 per-resource 属性（写在 <script> 标签的 integrity= 上），不是
# HTTP 头，所以本文件不直接配置。完整 SRI 注册表见 `web/js/csp.js`：
#   - marked@12.0.2      https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js
#   - dompurify@3.1.6    https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js
# 两份 bundle 的 sha384 digest 写在 csp.js 的 SCRIPTS 表里，由 app.js 的
# `litecode.markdown.prewarm()` 在首次渲染 Markdown 时通过
# `csp.makeScript(spec)` 注入到 <head>。浏览器会在执行前校验 hash；任
# 何字节变化都会让脚本被拒绝并抛 `Failed to find a valid digest in the
# 'integrity' attribute` 错误，UI 走 escaped-text fallback。
# 升级 marked/dompurify 时：
#   1. 从 cdn.jsdelivr.net 重新拉新版本
#   2. openssl dgst -sha384 -binary marked.min.js | openssl base64 -A
#   3. 把 digest + url 同步更新到 web/js/csp.js 的 SCRIPTS 表
# =============================================================

# ───── 本地开发（默认） ──────────────────────────────────────
{
    # 全局选项
    admin off                       # 禁用 admin API（容器内无需）
    auto_https off                  # 本地不自动 HTTPS
    # log 格式：JSON，便于 Loki/ELK 聚合
    log default {
        format json
        level INFO
    }
}

# HTTP 入口，转发到 web 容器
:80 {
    # 把真实客户端 IP 透传给后端（X-Forwarded-For）
    reverse_proxy litecode-web:8080 {
        # 健康检查（被代理端）
        health_uri /api/v1/health
        health_interval 10s
        health_timeout 5s

        # 透明传输 Header
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # 响应头：CSP（与前端 <meta http-equiv="Content-Security-Policy">
        # 配套，防御纵深；两个策略取交集生效，所以保持字面完全一致——
        # 见 web/js/csp.js 的 CSP_VALUE 单点定义）。新增指令：
        #   - object-src 'none'    — 禁止 <object>/<embed>，杜绝 Flash 风格攻击
        #   - base-uri 'self'      — 防止 <base href> 注入劫持相对 URL
        #   - form-action 'self'   — 防止表单外发到恶意 origin
        #   - font-src 'self'      — 当前没有 web font，但显式声明便于审计
        # 不在 script-src 加 'unsafe-inline'：所有页面脚本均走外部文件 +
        # 加载顺序为 csp.js → api.js → app.js。
        header_down Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

        # 隐藏后端服务器信息
        header_down -Server
        header_down -X-Powered-By
    }

    # 安全响应头
    header {
        # 防 XSS / MIME sniffing / clickjacking
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # HSTS 仅在 HTTPS 启用（避免本地 HTTP 下浏览器拒绝）
        # Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # 移除泄露信息的头
        -Server
    }

    # 编码：交给 Caddy 自动 gzip
    encode gzip zstd
}

# ───── 生产示例（取消注释并填入域名） ──────────────────────
# 1. 在 Caddyfile 同目录放 Caddy 自动获取证书需要的 DNS API token 环境变量
# 2. Caddy 启动时会自动从 Let's Encrypt 申请证书
# 3. 若需 cloudflare / alidns 等 DNS-01 验证，参考：
#    https://github.com/caddy-dns/cloudflare
#    https://github.com/caddy-dns/alidns
#
